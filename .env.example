# Host IP address and port for SSH connections.
GIT_SERVER_IP_ADDRESS=127.0.0.1
GIT_SERVER_SSH_PORT=2222

# Host folder with the users' public keys, one *.pub file per key. Changes take
# effect automatically. The folder must exist and be readable by everyone, and
# so must the key files (chmod 755 and 644 respectively).
GIT_SERVER_SSH_AUTHORIZED_KEYS_DIR=./authorized-keys

# Optional: UID and GID for the git user inside the container, 998 by default.
# Changing these values later requires rebuilding the Docker image and updating
# the owner of the repositories volume.
# GIT_SERVER_UID=998
# GIT_SERVER_GID=998
